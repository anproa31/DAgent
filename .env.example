# Multi-datasource refactor: environment variables
#
# The legacy PostgreSQL container has been removed. The sandbox now uses
# DuckDB and reads/writes a single file on the shared ``datasource_data``
# Docker volume. Uploaded files and the registry manifest live on the same
# volume under ``/data/datasources``.

# Path the sandbox uses for its DuckDB database file (inside the container).
SANDBOX_DUCKDB_PATH=/data/sandbox.duckdb

# Root directory used by the datasource registry for uploaded files and the
# ``registry.json`` manifest (inside the app container).
DATASOURCE_ROOT=/data/datasources

# Inter-service URLs (defaults are correct for docker-compose; only override
# if you run services outside the default network).
CODE_RUNNER_URL=http://data-analysis-agent-sandbox:8001/
APP_SERVICE_URL=http://data-analysis-agent-app:8000

# (Optional) LLM provider defaults. The frontend can also pass these per-run.
# OPENAI_BASE_URL=http://host.docker.internal:11434/v1
# OPENAI_API_KEY=none
