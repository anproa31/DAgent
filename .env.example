# Multi-datasource refactor: environment variables
#
# The legacy PostgreSQL container has been removed. The sandbox now uses
# DuckDB and reads/writes a single file on the shared datasource volume.
# Compose maps it to Docker volume ``dev_datasource_data`` (dev) or ``prod_datasource_data`` (prod).

# Path the sandbox uses for its DuckDB database file (inside the container).
SANDBOX_DUCKDB_PATH=/data/sandbox.duckdb

# Root directory used by the datasource registry for uploaded files and the
# ``registry.json`` manifest (inside the app container).
DATASOURCE_ROOT=/data/datasources

# Inter-service URLs inside Compose: dev (`daa-dev`) and prod (`daa-prod`) use the same
# service names (`sandbox`, `app`). Copy this file to ``.env`` once; switch stacks only via
# ``docker-compose.yml`` vs ``docker-compose.dev.yml`` — these defaults stay valid.
CODE_RUNNER_URL=http://sandbox:8001/
APP_SERVICE_URL=http://app:8000

# Databao Context Engine (in-process library; domain stored on the datasource volume).
# Requires Ollama with the embedding model (default nomic-embed-text-v2-moe) reachable from containers.
DCE_DOMAIN_DIR=/data/datasources/dce_domain
DCE_OLLAMA_HOST=host.docker.internal
DCE_OLLAMA_PORT=11434
# DCE resolves a local ollama binary unless a remote host is set; this sentinel avoids in-container download.
# DCE_OLLAMA_BIN=/bin/sh
# DCE_SEARCH_LIMIT=15

# Postgres for agent-service chat/run persistence (async via psycopg3). Defaults match the
# ``postgres`` Compose service; psycopg3 serves both the app's async engine and Alembic's sync engine.
DATABASE_URL=postgresql+psycopg://daa:daa@postgres:5432/daa_agent
POSTGRES_USER=daa
POSTGRES_PASSWORD=daa
POSTGRES_DB=daa_agent
# For the Alembic CLI from the host (dev maps Postgres to localhost:5433):
# DATABASE_URL_SYNC=postgresql+psycopg://daa:daa@localhost:5433/daa_agent

# (Optional) LLM provider defaults. The frontend can also pass these per-run.
# OPENAI_BASE_URL=http://host.docker.internal:11434/v1
# OPENAI_API_KEY=none

# --- Memory system (memory.md) ---
# Vector store (Qdrant) + working-memory cache (Redis). Defaults match Compose service names.
QDRANT_URL=http://qdrant:6333
REDIS_URL=redis://redis:6379
# Embedding endpoint default. The frontend Settings UI overrides these per request; this is
# only the server-side fallback. nomic-embed-text-v2-moe -> 768-dim vectors.
EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
EMBEDDING_MODEL=nomic-embed-text-v2-moe
EMBEDDING_DIMS=768
# Memory scoping key (no auth model yet); all KB/skills are global per deployment.
MEMORY_USER_ID=default
# Upload + chunking limits.
MAX_UPLOAD_SIZE_MB=50
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Web data discovery (app service outbound fetch)
# WEB_FETCH_MAX_BYTES=52428800
# WEB_FETCH_TIMEOUT=30
# WEB_DISCOVER_MAX_SEARCH=10
# WEB_DISCOVER_MAX_FETCH=3
# WEB_ALLOW_UNTRUSTED=0
