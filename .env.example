# Multi-datasource refactor: environment variables
#
# The legacy PostgreSQL container has been removed. The sandbox now uses
# DuckDB and reads/writes a single file on the shared datasource volume.
# Compose maps it to Docker volume ``dev_datasource_data`` (dev) or ``prod_datasource_data`` (prod).

# Path the sandbox uses for its DuckDB database file (inside the container).
SANDBOX_DUCKDB_PATH=/data/sandbox.duckdb

# Root directory used by the datasource registry for uploaded files and the
# ``registry.json`` manifest (inside the app container).
DATASOURCE_ROOT=/data/datasources

# Inter-service URLs inside Compose: dev (`daa-dev`) and prod (`daa-prod`) use the same
# service names (`sandbox`, `app`). Copy this file to ``.env`` once; switch stacks only via
# ``docker-compose.yml`` vs ``docker-compose.dev.yml`` — these defaults stay valid.
CODE_RUNNER_URL=http://sandbox:8001/
APP_SERVICE_URL=http://app:8000

# Context-engine microservice (semantic /build + query-aware /enhance). In Compose this is the
# ``context-engine`` service; for host-run agents against dev ports use http://localhost:8172
CONTEXT_ENGINE_URL=http://context-engine:8002/

# (Optional) SQLite URL for agent-service chat session persistence (async SQLAlchemy).
# For Alembic CLI against SQLite on the host, set DATABASE_URL_SYNC, e.g.:
# DATABASE_URL_SYNC=sqlite:///./data/agent.db
# DATABASE_URL=sqlite+aiosqlite:///./data/agent.db

# (Optional) LLM provider defaults. The frontend can also pass these per-run.
# OPENAI_BASE_URL=http://host.docker.internal:11434/v1
# OPENAI_API_KEY=none

# Web data discovery (app service outbound fetch)
# WEB_FETCH_MAX_BYTES=52428800
# WEB_FETCH_TIMEOUT=30
# WEB_DISCOVER_MAX_SEARCH=10
# WEB_DISCOVER_MAX_FETCH=3
# WEB_ALLOW_UNTRUSTED=0
