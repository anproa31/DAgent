# Demo PostgreSQL (sample_dataset/db_test)
POSTGRES_USER=demo
POSTGRES_PASSWORD=demo
POSTGRES_DB=hr_analytics
POSTGRES_PORT=5433

# Use in the app UI → Connect database → Connection string
DEMO_DB_CONNECTION_STRING=postgresql://demo:demo@localhost:5433/hr_analytics

# When the app runs inside Docker (docker-compose.dev.yml), use host gateway:
DEMO_DB_CONNECTION_STRING_DOCKER=postgresql://demo:demo@host.docker.internal:5433/hr_analytics
